"Direction":"long","Rules":{"EntryLong":{"Logic":"all","Negate":false,"Conditions":[],"IsEmpty":true},"ExitLong":{"Logic":"all","Negate":false,"Conditions":[],"IsEmpty":true},"EntryShort":{"Logic":"all","Negate":false,"Conditions":[],"IsEmpty":true},"ExitShort":{"Logic":"all","Negate":false,"Conditions":[],"IsEmpty":true},"Filter":{"Logic":"all","Negate":false,"Conditions":[{"Kind":"compare","Enabled":true,"Left":{"Kind":"price","Indicator":null,"Params":{},"Output":null,"Field":"close","Value":null,"Input":null,"Formula":null,"Offset":0,"Scale":null},"Op":">","Right":{"Kind":"indicator","Indicator":"sma","Params":{"length":200},"Output":null,"Field":"close","Value":null,"Input":null,"Formula":null,"Offset":0,"Scale":null},"Right2":null,"Bars":1,"Group":null,"Formula":null,"Note":null}],"IsEmpty":false}},"Sizing":{"Mode":"percent","Value":95.0,"MaxPositions":5,"MaxPositionPct":100.0},"Risk":{"StopLoss":{"Mode":"none","Value":0.0,"AtrLength":14},"TakeProfit":{"Mode":"none","Value":0.0,"AtrLength":14},"Trailing":{"Mode":"none","Value":0.0,"AtrLength":14},"MaxBarsInTrade":0,"CooldownBars":0,"ExitOnFilterOff":false},"Ranking":{"Score":"roc(close, 252)","Top":1,"Bottom":0,"RebalanceBars":21,"Weighting":"equal","GrossExposure":0.98,"MinDollarVolume":0.0}},"Source":null},{"Id":"script-blank","Name":"Script: blank","Description":"An empty single-symbol script with the API at hand.","Kind":"Script","Category":"Script","Symbol":"BTCUSDT","Interval":"OneDay","Blueprint":null,"Source":"[TradingStrategy(\"My strategy\", \"What it does.\")]\r\npublic class MyStrategy : ScriptStrategy\r\n{\r\n    [Param(\"Fast\", Min = 2, Max = 200)] public int Fast { get; set; } = 20;\r\n    [Param(\"Slow\", Min = 5, Max = 400)] public int Slow { get; set; } = 50;\r\n\r\n    public override void OnBar()\r\n    {\r\n        // Prices: Close, Open, High, Low, Volume, C(ago) …  Indicators: Ema(n), Rsi(n), Atr(n), F(\"any formula\") …\r\n        // Orders: BuyPercent(pct), ShortPercent(pct), SetTargetPercent(pct), ExitLong(), Exit() …\r\n        bool up = Ema(Fast) > Ema(Slow);\r\n        if (up && IsFlat) BuyPercent(95);\r\n        else if (!up && IsLong) ExitLong();\r\n        Plot(\"spread %\", (Ema(Fast) / Ema(Slow) - 1) * 100);\r\n    }\r\n}"},{"Id":"script-keltner","Name":"Script: Keltner breakout + ATR trail","Description":"Breakout above the Keltner upper band with an ATR trailing stop managed in code.","Kind":"Script","Category":"Script","Symbol":"BTCUSDT","Interval":"OneDay","Blueprint":null,"Source":"[TradingStrategy(\"Keltner breakout\", \"Close above the upper Keltner band; trail at 3 ATR from the highest close.\")]\r\npublic class KeltnerBreakout : ScriptStrategy\r\n{\r\n    [Param(\"Length\", Min = 5, Max = 100)] public int Length { get; set; } = 20;\r\n    [Param(\"Band mult\", Min = 0.5, Max = 5, Step = 0.1)] public double Mult { get; set; } = 2;\r\n    [Param(\"Trail ATR\", Min = 1, Max = 8, Step = 0.5)] public double Trail { get; set; } = 3;\r\n\r\n    private double highest;\r\n\r\n    public override void OnBar()\r\n    {\r\n        var kc = Keltner(Length, Mult);\r\n        if (IsFlat)\r\n        {\r\n            if (Close > kc.Upper) { BuyPercent(95); highest = Close; }\r\n            return;\r\n        }\r\n        highest = Math.Max(highest, Close);\r\n        double stop = highest - Trail * Atr(14);\r\n        Plot(\"trail\", stop);\r\n        if (Close < stop) ExitLong();\r\n    }\r\n}"},{"Id":"script-zscore","Name":"Script: z-score mean reversion (long/short)","Description":"Fade 2-sigma moves from the rolling mean; flat at the mean. Shorts need leverage.","Kind":"Script","Category":"Script","Symbol":"BTCUSDT","Interval":"OneHour","Blueprint":null,"Source":"[TradingStrategy(\"Z-score reversion\", \"Short above +Z, long below −Z, flat when the z-score crosses zero.\")]\r\npublic class ZScoreReversion : ScriptStrategy\r\n{\r\n    [Param(\"Lookback\", Min = 10, Max = 500)] public int Lookback { get; set; } = 48;\r\n    [Param(\"Entry Z\", Min = 0.5, Max = 4, Step = 0.1)] public double EntryZ { get; set; } = 2;\r\n\r\n    public override void OnBar()\r\n    {\r\n        double z = ZScore(Lookback);\r\n        Plot(\"z\", z);\r\n        if (double.IsNaN(z)) return;\r\n        if (IsFlat)\r\n        {\r\n            if (z < -EntryZ) SetTargetPercent(90);\r\n            else if (z > EntryZ) SetTargetPercent(-90);\r\n        }\r\n        else if ((IsLong && z >= 0) || (IsShort && z <= 0)) Exit();\r\n    }\r\n}"},{"Id":"script-xsmom","Name":"Script: cross-sectional momentum","Description":"Universe script: rank the liquid crypto universe by 60-day return, hold the top 8 equal-weight, monthly.","Kind":"Script","Category":"Script","Symbol":"BTCUSDT","Interval":"OneDay","Blueprint":null,"Source":"[TradingStrategy(\"XS momentum (script)\", \"Top-N by trailing return, equal weight, rebalanced every 30 bars.\", RequiresUniverse = true)]\r\npublic class CrossSectionalMomentum : ScriptUniverseStrategy\r\n{\r\n    [Param(\"Lookback\", Min = 10, Max = 252)] public int Lookback { get; set; } = 60;\r\n    [Param(\"Hold\", Min = 1, Max = 30)] public int Hold { get; set; } = 8;\r\n    [Param(\"Rebalance every\", Min = 1, Max = 60)] public int Every { get; set; } = 30;\r\n\r\n    public override void OnBar(UniverseView u)\r\n    {\r\n        if ((BarNumber - 1) % Every != 0) return;\r\n        var regimeOk = u.Close(RegimeSymbol) > u.F(RegimeSymbol, \"sma(close, 100)\");\r\n        var ranked = u.Symbols\r\n            .Where(s => u.Bars(s) > Lookback)\r\n            .Select(s => (s, ret: u.F(s, $\"roc(close, {Lookback})\")))\r\n            .Where(x => !double.IsNaN(x.ret))\r\n            .OrderByDescending(x => x.ret)\r\n            .Take(Hold)\r\n            .ToList();\r\n        var weights = new Dictionary<string, double>();\r\n        if (regimeOk) foreach (var (s, _) in ranked) weights[s] = 0.98 / ranked.Count;\r\n        SetWeights(weights);\r\n    }\r\n}"}]